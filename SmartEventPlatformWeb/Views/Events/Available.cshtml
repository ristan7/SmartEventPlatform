@model IEnumerable<SmartEventPlatformWeb.ViewModels.Events.AvailableEventViewModel>

@{
    ViewData["Title"] = "Available Events";
}

<h1>Available Events</h1>

<p>
    This page displays upcoming events that still have available seats for registration.
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Agenda</th>
            <th>Date and Time</th>
            <th>Duration</th>
            <th>Registration Fee</th>
            <th>Location</th>
            <th>Speakers</th>
            <th>Available Seats</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EventName</td>
                <td>@item.Agenda</td>
                <td>@item.EventDateTime.ToString("dd.MM.yyyy. HH:mm")</td>
                <td>@item.DurationInMinutes min</td>
                <td>@item.RegistrationFee.ToString("N2") RSD</td>
                <td>@item.LocationName</td>
                <td>
                    @if (item.Speakers.Any())
                    {
                        @string.Join(", ", item.Speakers)
                    }
                    else
                    {
                        <span class="text-muted">No speakers</span>
                    }
                </td>
                <td>
                    <strong>@item.AvailableSeats</strong> / @item.Capacity
                </td>
                <td>
                    <a asp-controller="Registrations"
                       asp-action="Create"
                       asp-route-eventId="@item.EventId"
                       class="btn btn-primary btn-sm">
                        Register
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>