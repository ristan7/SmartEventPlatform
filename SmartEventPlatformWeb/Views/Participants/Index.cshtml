@model IEnumerable<SmartEventPlatformWeb.ViewModels.Participants.ParticipantListViewModel>

@{
    ViewData["Title"] = "Participants";
}

<h1>Participants</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.FirstName @item.LastName</td>
            <td>@item.Email</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.ParticipantId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.ParticipantId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.ParticipantId">Delete</a>
                </td>
        </tr>
}
    </tbody>
</table>
