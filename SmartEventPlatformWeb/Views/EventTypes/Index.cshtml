@model IEnumerable<SmartEventPlatformWeb.ViewModels.EventTypes.EventTypeListViewModel>

@{
    ViewData["Title"] = "Event Types";
}

<h1>Event Types</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<p>
    <a class="btn btn-primary" asp-action="Create">Create New Type</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.EventTypeId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.EventTypeId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.EventTypeId">Delete</a>
                </td>
        </tr>
}
    </tbody>
</table>
