@model SmartEventPlatformWeb.ViewModels.Registrations.RegistrationEditViewModel

@{
    ViewData["Title"] = "Edit Registration";
}

<h1>Edit Registration</h1>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="RegistrationId" />

    <div class="form-group mb-3">
        <label asp-for="EventId" class="control-label">Event</label>
        <select asp-for="EventId" asp-items="Model.Events" class="form-control">
            <option value="0">-- Select event --</option>
        </select>
        <span asp-validation-for="EventId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ParticipantId" class="control-label">Participant</label>
        <select asp-for="ParticipantId" asp-items="Model.Participants" class="form-control">
            <option value="0">-- Select participant --</option>
        </select>
        <span asp-validation-for="ParticipantId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="RegistrationDate" class="control-label">Registration Date</label>
        <input asp-for="RegistrationDate" class="form-control" />
        <span asp-validation-for="RegistrationDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}