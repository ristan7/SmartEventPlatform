@model SmartEventPlatformWeb.ViewModels.Registrations.RegistrationDeleteViewModel

@{
    ViewData["Title"] = "Delete Registration";
}

<h1>Delete Registration</h1>

<h3>Are you sure you want to delete this registration?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Event</dt>
        <dd class="col-sm-10">@Model.EventName</dd>
        <dt class="col-sm-2">Participant</dt>
        <dd class="col-sm-10">@Model.ParticipantFullName</dd>
        <dt class="col-sm-2">Registration Date</dt>
        <dd class="col-sm-10">@Model.RegistrationDate.ToString("g")</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="RegistrationId" />
    <div class="form-group">
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</form>
