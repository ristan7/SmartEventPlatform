@model SmartEventPlatformWeb.ViewModels.Registrations.RegistrationDetailsViewModel

@{
    ViewData["Title"] = "Registration Details";
}

<h1>Registration Details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">Event</dt>
        <dd class="col-sm-10">@Model.EventName</dd>

        <dt class="col-sm-2">Participant</dt>
        <dd class="col-sm-10">@Model.ParticipantFullName</dd>

        <dt class="col-sm-2">Registration Date</dt>
        <dd class="col-sm-10">@Model.RegistrationDate.ToString("g")</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.RegistrationId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>