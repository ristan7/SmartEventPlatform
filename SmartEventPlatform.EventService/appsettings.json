{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=SmartEventPlatform_EventDB;Integrated Security=True;Connect Timeout=30;Encrypt=False;Trust Server Certificate=True;"
  },
  "ServiceEndpoints": {
    "RegistrationService": "https://localhost:7292",
    "DirectoryService": "https://localhost:7103"
  },
  "RabbitMqPublisher": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "Exchange": "smart-event.event-integration",
    "LocationUsageRoutingKey": "event.location-usage.changed",
    "LocationUsageQueue": "directory.location-usage.queue",
    "SpeakerUsageRoutingKey": "event.speaker-usage.changed",
    "SpeakerUsageQueue": "directory.speaker-usage.queue",
    "DeadLetterExchange": "smart-event.dlx",
    "LocationUsageDlq": "directory.location-usage.dlq",
    "SpeakerUsageDlq": "directory.speaker-usage.dlq"
  },
  "RabbitMqConsumer": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "Exchange": "smart-event.registration-integration",
    "Queue": "event.registration-usage.queue",
    "RoutingKey": "registration.event-usage.changed",
    "PrefetchCount": 1,
    "DeadLetterExchange": "smart-event.dlx",
    "DeadLetterQueue": "event.registration-usage.dlq",
    "MaxRetryCount": 10
  },
  "RabbitMqEventQuery": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "RequestQueue": "event.query.request.queue"
  },
  "SagaChoreography": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "Exchange": "smart-event.saga-choreography",
    "DeadLetterExchange": "smart-event.saga-choreography.dlx",
    "EventServiceQueue": "saga-choreo.event-service.queue",
    "EventServiceRoutingKey": "saga.event-service",
    "EventServiceDlq": "saga-choreo.event-service.dlq",
    "DirectoryServiceQueue": "saga-choreo.directory-service.queue",
    "DirectoryServiceRoutingKey": "saga.directory-service",
    "DirectoryServiceDlq": "saga-choreo.directory-service.dlq",
    "RegistrationServiceQueue": "saga-choreo.registration-service.queue",
    "RegistrationServiceRoutingKey": "saga.registration-service",
    "RegistrationServiceDlq": "saga-choreo.registration-service.dlq",
    "PrefetchCount": 10,
    "MaxRetryCount": 10
  }
}