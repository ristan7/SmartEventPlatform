    }
  ],

  // =================================================================
  // GLOBAL CONFIGURATION
  // =================================================================
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5200",

    // -----------------------------------------------------------------
    // FUNCTIONALITY 2: RATE LIMITING
    // Max 30 requests per 30 seconds per client (identified by X-ClientId header).
    // Clients that exceed the limit receive HTTP 429 Too Many Requests.
    // -----------------------------------------------------------------
    "RateLimitOptions": {
      "ClientIdHeader": "X-ClientId",
      "Limit": 30,
      "Period": "30s",
      "PeriodTimespan": 30,
      "StatusCode": 429,
      "QuotaExceededMessage": "API rate limit exceeded! Maximum {0} requests allowed per {1} period.",
      "HttpStatusCode": 429,
      "DisableRateLimitHeaders": false
    }
  }
