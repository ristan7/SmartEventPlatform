{
  "Routes": [

    // =================================================================
    // FUNKCIONALNOST 1: RUTIRANJE (Routing)
    // Svaka ruta mapira upstream putanju (sta klijent salje gatewaju)
    // na downstream putanju (sta gateway prosljedjuje servisu).
    // =================================================================

    // -----------------------------------------------------------------
    // EVENTS - GET lista dogadjaja
    // FUNKCIONALNOST 3: KESIRANJE (CacheOptions - TTL 60 sekundi)
    // FUNKCIONALNOST 4: LOAD BALANCING (LeastConnection)
    //   LeastConnection salje zahtjev serveru koji ima najmanje
    //   aktivnih veza. U dev okruzenju postoji samo jedna instanca,
    //   ali konfiguracija demonstrira obrazac za skaliranje.
    // -----------------------------------------------------------------
    {
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamPathTemplate": "/gateway/events",
      "DownstreamPathTemplate": "/api/events",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5022
        }
      ],
      "CacheOptions": {
        "TtlSeconds": 60,
        "Region": "events"
      },
      "LoadBalancerOptions": {
        "Type": "LeastConnection"
      },
      "Key": "events-list"
    },

    // -----------------------------------------------------------------
    // EVENTS - GET detalji jednog dogadjaja (sa kesom)
    // -----------------------------------------------------------------
    {
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamPathTemplate": "/gateway/events/{id}",
      "DownstreamPathTemplate": "/api/events/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5022
        }
      ],
      "CacheOptions": {
        "TtlSeconds": 60,
        "Region": "events"
      }
    },

    // -----------------------------------------------------------------
    // EVENTS - GET nadolazeci dogadjaji
    // -----------------------------------------------------------------
    {
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamPathTemplate": "/gateway/events/upcoming",
      "DownstreamPathTemplate": "/api/events/upcoming",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5022
        }
      ]
    },

    // -----------------------------------------------------------------
    // EVENTS - POST kreiraj dogadjaj
    // -----------------------------------------------------------------
    {
      "UpstreamHttpMethod": [ "Post" ],
      "UpstreamPathTemplate": "/gateway/events",
      "DownstreamPathTemplate": "/api/events",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5022
        }
      ]
    },

    // -----------------------------------------------------------------
    // EVENTS - PUT azuriraj dogadjaj
    // -----------------------------------------------------------------
    {
      "UpstreamHttpMethod": [ "Put" ],
      "UpstreamPathTemplate": "/gateway/events/{id}",
      "DownstreamPathTemplate": "/api/events/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5022
        }
      ]
    },

    // -----------------------------------------------------------------
    // EVENTS - DELETE obrisi dogadjaj
    // -----------------------------------------------------------------
    {
      "UpstreamHttpMethod": [ "Delete" ],
      "UpstreamPathTemplate": "/gateway/events/{id}",
      "DownstreamPathTemplate": "/api/events/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5022
        }
      ]
    },

    // -----------------------------------------------------------------
    // EVENT TYPES - CRUD
    // -----------------------------------------------------------------
    {
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamPathTemplate": "/gateway/eventtypes",
      "DownstreamPathTemplate": "/api/eventtypes",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5022
        }
      ],
      "CacheOptions": {
        "TtlSeconds": 120,
        "Region": "eventtypes"
      }
    },
    {
      "UpstreamHttpMethod": [ "Get", "Put", "Delete" ],
      "UpstreamPathTemplate": "/gateway/eventtypes/{id}",
      "DownstreamPathTemplate": "/api/eventtypes/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5022
        }
      ]
    },
    {
      "UpstreamHttpMethod": [ "Post" ],
      "UpstreamPathTemplate": "/gateway/eventtypes",
      "DownstreamPathTemplate": "/api/eventtypes",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5022
        }
      ]
    },

    // -----------------------------------------------------------------
    // EVENT SPEAKERS - CRUD
    // -----------------------------------------------------------------
    {
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamPathTemplate": "/gateway/eventspeakers",
      "DownstreamPathTemplate": "/api/eventspeakers",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5022
        }
      ]
    },
    {
      "UpstreamHttpMethod": [ "Get", "Delete" ],
      "UpstreamPathTemplate": "/gateway/eventspeakers/{eventId}/{speakerId}",
      "DownstreamPathTemplate": "/api/eventspeakers/{eventId}/{speakerId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5022
        }
      ]
    },
    {
      "UpstreamHttpMethod": [ "Post" ],
      "UpstreamPathTemplate": "/gateway/eventspeakers",
      "DownstreamPathTemplate": "/api/eventspeakers",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5022
        }
      ]
    },

    // =================================================================
    // DIRECTORY SERVICE - LOKACIJE
    // FUNKCIONALNOST 3: KESIRANJE na GET ruti
    // =================================================================

    // -----------------------------------------------------------------
    // LOCATIONS - GET lista lokacija (sa kesom)
    // FUNKCIONALNOST 5: API KOMPOZICIJA - ova ruta ima Key "locations-list"
    //   sto je koristi Ocelot agregator (vidi Aggregates ispod)
    // -----------------------------------------------------------------
    {
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamPathTemplate": "/gateway/locations",
      "DownstreamPathTemplate": "/api/locations",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5103
        }
      ],
      "CacheOptions": {
        "TtlSeconds": 120,
        "Region": "locations"
      },
      "Key": "locations-list"
    },

    // -----------------------------------------------------------------
    // LOCATIONS - GET detalji lokacije
    // -----------------------------------------------------------------
    {
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamPathTemplate": "/gateway/locations/{id}",
      "DownstreamPathTemplate": "/api/locations/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5103
        }
      ]
    },

    // -----------------------------------------------------------------
    // LOCATIONS - POST kreiraj lokaciju
    // -----------------------------------------------------------------
    {
      "UpstreamHttpMethod": [ "Post" ],
      "UpstreamPathTemplate": "/gateway/locations",
      "DownstreamPathTemplate": "/api/locations",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5103
        }
      ]
    },

    // -----------------------------------------------------------------
    // LOCATIONS - PUT / DELETE
    // -----------------------------------------------------------------
    {
      "UpstreamHttpMethod": [ "Put", "Delete" ],
      "UpstreamPathTemplate": "/gateway/locations/{id}",
      "DownstreamPathTemplate": "/api/locations/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5103
        }
      ]
    },

    // -----------------------------------------------------------------
    // SPEAKERS - GET lista predavaca (sa kesom)
    // -----------------------------------------------------------------
    {
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamPathTemplate": "/gateway/speakers",
      "DownstreamPathTemplate": "/api/speakers",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5103
        }
      ],
      "CacheOptions": {
        "TtlSeconds": 120,
        "Region": "speakers"
      }
    },
    {
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamPathTemplate": "/gateway/speakers/{id}",
      "DownstreamPathTemplate": "/api/speakers/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5103
        }
      ]
    },
    {
      "UpstreamHttpMethod": [ "Post" ],
      "UpstreamPathTemplate": "/gateway/speakers",
      "DownstreamPathTemplate": "/api/speakers",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5103
        }
      ]
    },
    {
      "UpstreamHttpMethod": [ "Put", "Delete" ],
      "UpstreamPathTemplate": "/gateway/speakers/{id}",
      "DownstreamPathTemplate": "/api/speakers/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5103
        }
      ]
    },

    // =================================================================
    // REGISTRATION SERVICE
    // =================================================================

    // -----------------------------------------------------------------
    // REGISTRATIONS - CRUD
    // -----------------------------------------------------------------
    {
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamPathTemplate": "/gateway/registrations",
      "DownstreamPathTemplate": "/api/registrations",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ]
    },
    {
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamPathTemplate": "/gateway/registrations/{id}",
      "DownstreamPathTemplate": "/api/registrations/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ]
    },
    {
      "UpstreamHttpMethod": [ "Post" ],
      "UpstreamPathTemplate": "/gateway/registrations",
      "DownstreamPathTemplate": "/api/registrations",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ]
    },
    {
      "UpstreamHttpMethod": [ "Delete" ],
      "UpstreamPathTemplate": "/gateway/registrations/{id}",
      "DownstreamPathTemplate": "/api/registrations/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ]
    },

    // -----------------------------------------------------------------
    // PARTICIPANTS - CRUD
    // -----------------------------------------------------------------
    {
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamPathTemplate": "/gateway/participants",
      "DownstreamPathTemplate": "/api/participants",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ]
    },
    {
      "UpstreamHttpMethod": [ "Get", "Put", "Delete" ],
      "UpstreamPathTemplate": "/gateway/participants/{id}",
      "DownstreamPathTemplate": "/api/participants/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ]
    },
    {
      "UpstreamHttpMethod": [ "Post" ],
      "UpstreamPathTemplate": "/gateway/participants",
      "DownstreamPathTemplate": "/api/participants",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ]
    },

    // -----------------------------------------------------------------
    // AVAILABLE EVENTS
    // -----------------------------------------------------------------
    {
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamPathTemplate": "/gateway/availableevents",
      "DownstreamPathTemplate": "/api/availableevents",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ]
    },

    // =================================================================
    // FUNKCIONALNOST 5: API KOMPOZICIJA (Aggregation)
    // Rute sa Key su input za agregator.
    // Agregator pravi dva paralelna poziva ka EventService i DirectoryService,
    // i vraca kombinovani JSON objekat sa oba odgovora spojenim.
    //
    // Upstream:  GET /gateway/dashboard
    // Downstream: istovremeno zove /gateway/events i /gateway/locations
    //             i spaja odgovore u jedan JSON
    //
    // (vidi Aggregates sekciju ispod)
    // =================================================================

    // =================================================================
    // FUNKCIONALNOST 10: UPRAVLJANJE VERZIJAMA API-ja (API Versioning)
    // Klijent koristi /api/v1/events na gatewaju,
    // a gateway prosljedjuje na /api/events servisu.
    // Na ovaj nacin mozemo u buducnosti dodati /api/v2/events
    // koji ce ukazivati na drugaciju logiku, bez mjenjanja servisa.
    // =================================================================
    {
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamPathTemplate": "/api/v1/events",
      "DownstreamPathTemplate": "/api/events",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5022
        }
      ],
      "CacheOptions": {
        "TtlSeconds": 60,
        "Region": "events"
      }
    },
    {
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamPathTemplate": "/api/v1/locations",
      "DownstreamPathTemplate": "/api/locations",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5103
        }
      ],
      "CacheOptions": {
        "TtlSeconds": 120,
        "Region": "locations"
      }
    },
    {
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamPathTemplate": "/api/v1/registrations",
      "DownstreamPathTemplate": "/api/registrations",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ]
    }

  ],

  // =================================================================
  // FUNKCIONALNOST 5: API KOMPOZICIJA
  // Aggregates kombinuje odgovore vise ruta u jedan JSON.
  //
  // Poziv:   GET http://localhost:5200/gateway/dashboard
  // Ocelot zove paralelno:
  //   - Rutu sa Key "events-list"   -> EventService  GET /api/events
  //   - Rutu sa Key "locations-list" -> DirectoryService GET /api/locations
  // i vraca:
  // {
  //   "events-list":    [ ... lista dogadjaja ... ],
  //   "locations-list": [ ... lista lokacija ... ]
  // }
  // =================================================================
  "Aggregates": [
    {
      "UpstreamPathTemplate": "/gateway/dashboard",
      "RouteKeys": [ "events-list", "locations-list" ]
    }
  ],

  // =================================================================
  // GLOBALNA KONFIGURACIJA
  // =================================================================
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5200",

    // -----------------------------------------------------------------
    // FUNKCIONALNOST 2: RATE LIMITING
    // Globalno ogranicenje: max 30 zahtjeva u 30 sekundi po klijentu.
    // Klijent se identifikuje po ClientIdHeader (ovdje X-ClientId header).
    // Ako klijent prekoraci limit, dobija 429 Too Many Requests.
    // -----------------------------------------------------------------
    "RateLimitOptions": {
      "ClientIdHeader": "X-ClientId",
      "Limit": 30,
      "Period": "30s",
      "PeriodTimespan": 30,
      "StatusCode": 429,
      "QuotaExceededMessage": "Prekoracen limit API poziva! Dozvoljeno maksimalno {0} poziva za period {1}.",
      "HttpStatusCode": 429,
      "DisableRateLimitHeaders": false
    }
  }
}